---
interface Props {
  variant?: 'primary' | 'secondary' | 'ai' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  target?: string;
  rel?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  id?: string;
  ariaLabel?: string;
  download?: boolean | string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  target,
  rel = target === '_blank' ? 'noopener noreferrer' : undefined,
  class: className = '',
  type = 'button',
  id,
  ariaLabel,
  download
} = Astro.props;

import styles from './Button.module.css';
const buttonClasses = [
  styles.button,
  styles[`variant-${variant}`],
  styles[`size-${size}`],
  className
].filter(Boolean).join(' ');
---

{
  href ? (
    <a
      href={href}
      class={buttonClasses}
      target={target}
      rel={rel}
      id={id}
      aria-label={ariaLabel}
      download={download}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class={buttonClasses}
      id={id}
      aria-label={ariaLabel}
    >
      <slot />
    </button>
  )
}
