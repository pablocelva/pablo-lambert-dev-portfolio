---
import styles from './RecruiterBar.module.css';
---

<aside class={styles.bar} aria-label="Aviso rápido para Reclutadores Tech">
  <div class={`container ${styles.barContent}`}>
    <div class={styles.left}>
      <span class={styles.pulseDot} aria-hidden="true"></span>
      <p class={styles.text}>
        <strong class={styles.highlight}>Reclutador Tech o Lead?</strong> Accede al resumen ejecutivo con stack, disponibilidad y métricas clave.
      </p>
    </div>
    <button
      type="button"
      id="open-recruiter-drawer-btn"
      class={styles.actionBtn}
      aria-label="Abrir resumen ejecutivo para reclutadores"
    >
      <span>Ver Quick Pitch (TL;DR)</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </button>
  </div>
</aside>
